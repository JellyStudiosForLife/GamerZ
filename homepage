<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="GamerZ – Your gaming community. Discover events, news and new teammates.">
  <title>GamerZ – Gaming Community</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #060816;
      --bg2: #0b1022;
      --card: rgba(16, 22, 45, .72);
      --text: #f6f7ff;
      --muted: #9ca7c7;
      --purple: #8b2cff;
      --blue: #16c7ff;
      --line: rgba(255,255,255,.09);
    }
    html { scroll-behavior: smooth; }
    body {
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at 80% 15%, rgba(139,44,255,.18), transparent 28%),
        radial-gradient(circle at 15% 35%, rgba(22,199,255,.10), transparent 25%),
        var(--bg);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
    }
    a { color: inherit; text-decoration: none; }
    .container { width: min(1180px, calc(100% - 40px)); margin: auto; }

    /* NAV */
    nav {
      position: sticky; top: 0; z-index: 50;
      background: rgba(6,8,22,.78);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--line);
    }
    .nav-inner {
      height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 30px;
    }
    .logo { font-size: 27px; font-weight: 900; font-style: italic; letter-spacing: -1.5px; }
    .logo span {
      background: linear-gradient(90deg, #fff, #a93dff, #16c7ff);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .nav-links { display: flex; gap: 30px; color: #c9d0e7; font-size: 14px; font-weight: 600; }
    .nav-links a:hover { color: white; }
    .nav-actions { display: flex; gap: 10px; align-items: center; }
    .btn {
      border: 1px solid rgba(255,255,255,.14);
      padding: 11px 18px; border-radius: 12px; font-weight: 700; font-size: 14px;
      transition: .2s ease; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn-primary {
      border: 0;
      background: linear-gradient(110deg, #8427ff, #a72cff 45%, #12bdf7);
      box-shadow: 0 12px 35px rgba(139,44,255,.28);
    }
    .btn-ghost { background: rgba(255,255,255,.03); }

    /* HERO */
    .hero { position: relative; padding: 92px 0 105px; }
    .hero::before {
      content: ""; position: absolute; width: 520px; height: 520px; border-radius: 50%;
      right: -220px; top: -100px; background: rgba(139,44,255,.15); filter: blur(90px); pointer-events: none;
    }
    .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 65px; align-items: center; }
    .eyebrow {
      color: #a83cff; font-size: 13px; font-weight: 900; letter-spacing: 4px; text-transform: uppercase;
      margin-bottom: 18px;
    }
    h1 { font-size: clamp(54px, 7vw, 92px); line-height: .9; letter-spacing: -5px; }
    h1 .gradient {
      background: linear-gradient(90deg, #fff 15%, #a72cff 55%, #16c7ff);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .hero h2 { margin-top: 26px; font-size: clamp(23px, 3vw, 36px); line-height: 1.1; }
    .hero h2 span { color: #a72cff; }
    .hero p { margin: 20px 0 30px; color: var(--muted); max-width: 570px; line-height: 1.75; }
    .hero-buttons { display: flex; gap: 12px; flex-wrap: wrap; }

    /* CSS-ONLY GAMING VISUAL – no copyrighted game art */
    .visual {
      min-height: 410px; position: relative; display: grid; place-items: center;
      border: 1px solid rgba(139,44,255,.24); border-radius: 30px; overflow: hidden;
      background:
        linear-gradient(145deg, rgba(139,44,255,.13), rgba(22,199,255,.04)),
        repeating-linear-gradient(0deg, transparent 0 38px, rgba(255,255,255,.025) 39px 40px),
        #090d1e;
      box-shadow: inset 0 0 90px rgba(139,44,255,.10), 0 25px 80px rgba(0,0,0,.35);
    }
    .visual::before {
      content: ""; position: absolute; width: 270px; height: 270px; border-radius: 50%;
      background: rgba(139,44,255,.28); filter: blur(55px);
    }
    .screen {
      position: relative; width: 72%; height: 205px; border: 5px solid #202945; border-radius: 16px;
      background: linear-gradient(135deg, #111b45, #21113c 52%, #071c32);
      box-shadow: 0 0 40px rgba(22,199,255,.18);
    }
    .screen::after {
      content: "GZ"; position: absolute; inset: 0; display: grid; place-items: center;
      font-size: 80px; font-weight: 1000; font-style: italic; color: rgba(255,255,255,.08);
    }
    .screen-lines { position: absolute; left: 12%; right: 12%; bottom: 22px; height: 5px; border-radius: 10px;
      background: linear-gradient(90deg, #8b2cff 40%, #16c7ff 40%); }
    .stand { position: absolute; bottom: 48px; width: 85px; height: 48px; border-bottom: 5px solid #26304c; }
    .desk { position: absolute; bottom: 34px; width: 86%; height: 10px; border-radius: 10px; background: #1a223c; }
    .orb { position: absolute; width: 9px; height: 9px; border-radius: 50%; background: #16c7ff; box-shadow: 0 0 18px #16c7ff; }
    .orb.one { top: 25%; left: 13%; } .orb.two { top: 35%; right: 12%; background:#a72cff; box-shadow:0 0 18px #a72cff; }
    .orb.three { bottom: 22%; left: 18%; }

    /* FEATURES */
    section { padding: 78px 0; border-top: 1px solid var(--line); }
    .section-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 34px; }
    .section-head h2 { font-size: 38px; letter-spacing: -1.5px; }
    .section-head h2 span { color: #a72cff; }
    .section-head p { color: var(--muted); margin-top: 8px; }
    .cards { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; }
    .card {
      background: linear-gradient(145deg, rgba(19,26,53,.84), rgba(9,13,30,.84));
      border: 1px solid var(--line); border-radius: 20px; padding: 28px 22px; transition: .25s;
    }
    .card:hover { transform: translateY(-5px); border-color: rgba(139,44,255,.4); box-shadow: 0 18px 45px rgba(0,0,0,.24); }
    .icon {
      width: 50px; height: 50px; display: grid; place-items: center; border-radius: 15px;
      background: linear-gradient(145deg, rgba(139,44,255,.22), rgba(22,199,255,.10));
      border: 1px solid rgba(139,44,255,.3); font-size: 23px; margin-bottom: 20px;
    }
    .card h3 { margin-bottom: 9px; font-size: 18px; }
    .card p { color: var(--muted); font-size: 14px; line-height: 1.65; }

    /* COMMUNITY */
    .community {
      display: grid; grid-template-columns: 1fr 1fr; gap: 22px;
    }
    .panel {
      padding: 35px; border: 1px solid var(--line); border-radius: 24px;
      background: linear-gradient(135deg, rgba(139,44,255,.09), rgba(22,199,255,.035));
    }
    .stats { display:grid; grid-template-columns: repeat(3,1fr); gap: 12px; margin-top: 25px; }
    .stat { padding: 17px; border-radius: 15px; background: rgba(255,255,255,.035); border: 1px solid var(--line); }
    .stat strong { display:block; font-size: 25px; } .stat small { color: var(--muted); }
    .event {
      display:flex; align-items:center; gap:15px; padding: 15px 0; border-bottom:1px solid var(--line);
    }
    .event:last-child { border-bottom:0; }
    .date { min-width:52px; text-align:center; border-radius:12px; padding:9px 5px; background:rgba(139,44,255,.14); }
    .date b { display:block; font-size:18px; } .date small { color:#a72cff; }
    .event span { color:var(--muted); font-size:13px; }

    /* CTA / FOOTER */
    .cta { text-align:center; padding: 95px 20px; }
    .cta h2 { font-size: clamp(34px,5vw,58px); letter-spacing:-2px; }
    .cta p { color:var(--muted); margin: 14px auto 25px; max-width: 570px; line-height:1.7; }
    footer { border-top:1px solid var(--line); padding:25px 0; color:#69738f; font-size:13px; }
    .footer-inner { display:flex; justify-content:space-between; gap:20px; }

    @media (max-width: 900px) {
      .nav-links { display:none; }
      .hero-grid, .community { grid-template-columns:1fr; }
      .cards { grid-template-columns:repeat(2,1fr); }
      .visual { min-height:340px; }
    }
    @media (max-width: 560px) {
      .container { width:min(100% - 26px, 1180px); }
      .nav-inner { height:64px; }
      .nav-actions .btn-ghost { display:none; }
      .hero { padding:65px 0 75px; }
      h1 { letter-spacing:-3px; }
      .cards { grid-template-columns:1fr; }
      .stats { grid-template-columns:1fr; }
      .panel { padding:25px; }
      .footer-inner { flex-direction:column; }
    }
  </style>
</head>
<body>

<nav>
  <div class="container nav-inner">
    <a href="#" class="logo"><span>GamerZ</span></a>
    <div class="nav-links">
      <a href="#start">Home</a>
      <a href="#community">Community</a>
      <a href="#events">Events</a>
      <a href="#news">News</a>
    </div>
    <div class="nav-actions">
      <a class="btn btn-ghost" href="#community">Login</a>
      <a class="btn btn-primary" href="#join">Join Us</a>
    </div>
  </div>
</nav>

<main id="start">
  <section class="hero" style="border-top:0;">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">Welcome to</div>
        <h1><span class="gradient">GamerZ</span></h1>
        <h2>More than just gaming – <span>a community.</span></h2>
        <p>
          GamerZ is your digital hub for gaming, community, events and news.
          Find new teammates, connect with other gamers and become part of a community
          that shares your passion for gaming.
        </p>
        <div class="hero-buttons">
          <a class="btn btn-primary" href="#join">🎮 Join Now</a>
          <a class="btn btn-ghost" href="#community">Discover the Community →</a>
        </div>
      </div>

      <div class="visual" aria-label="Abstrakte Gaming-Illustration">
        <div class="orb one"></div><div class="orb two"></div><div class="orb three"></div>
        <div class="screen"><div class="screen-lines"></div></div>
        <div class="stand"></div><div class="desk"></div>
      </div>
    </div>
  </section>

  <section id="community">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Your <span>Gaming World</span></h2>
          <p>Everything you need for a great gaming community.</p>
        </div>
      </div>

      <div class="cards">
        <article class="card">
          <div class="icon">🎮</div>
          <h3>Gaming</h3>
          <p>Find teammates, discover new games and share your best gaming moments.</p>
        </article>
        <article class="card">
          <div class="icon">👥</div>
          <h3>Community</h3>
          <p>Meet other gamers, chat with the community and find people with the same interests.</p>
        </article>
        <article class="card" id="events">
          <div class="icon">🏆</div>
          <h3>Events</h3>
          <p>Take part in community events, tournaments and shared gaming nights.</p>
        </article>
        <article class="card" id="news">
          <div class="icon">⚡</div>
          <h3>News</h3>
          <p>Stay up to date with gaming trends, updates and exciting topics from the gaming scene.</p>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container community">
      <div class="panel">
        <div class="eyebrow">Community</div>
        <h2>Play together.<br><span class="gradient">Grow together.</span></h2>
        <p style="color:var(--muted); line-height:1.7; margin-top:15px;">
          GamerZ is a place where every gamer can feel welcome –
          from casual players to hardcore fans.
        </p>
        <div class="stats">
          <div class="stat"><strong>24/7</strong><small>Community</small></div>
          <div class="stat"><strong>∞</strong><small>Possibilities</small></div>
          <div class="stat"><strong>100%</strong><small>GamerZ</small></div>
        </div>
      </div>

      <div class="panel">
        <div class="eyebrow">Upcoming Events</div>
        <div class="event">
          <div class="date"><small>SEP</small><b>18</b></div>
          <div><b>Community Night</b><br><span>Gaming & chilling together</span></div>
        </div>
        <div class="event">
          <div class="date"><small>SEP</small><b>24</b></div>
          <div><b>Gaming Talk</b><br><span>News & discussions</span></div>
        </div>
        <div class="event">
          <div class="date"><small>OKT</small><b>03</b></div>
          <div><b>GamerZ Tournament</b><br><span>Community tournament</span></div>
        </div>
      </div>
    </div>
  </section>

  <section id="join" class="cta">
    <div class="container">
      <div class="eyebrow">Ready?</div>
      <h2>Become part of <span class="gradient">GamerZ.</span></h2>
      <p>Build your community, make new friends and turn gaming into a shared experience.</p>
      <a class="btn btn-primary" href="#">🚀 Get Started Free</a>
    </div>
  </section>
</main>

<footer>
  <div class="container footer-inner">
    <div>© 2026 GamerZ. All rights reserved.</div>
    <div>No official game brands, logos or copyrighted game artwork used.</div>
  </div>
</footer>

</body>
</html>
